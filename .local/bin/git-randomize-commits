#!/usr/bin/env bash
#
# git-randomize-commits — prepisuje datume (i opcionalno autore) zadnjih N commitova
#                         na nasumicna vremena unutar zadnjih M dana.
#
# UPOZORENJE: ovo prepisuje git istoriju (mijenja se SVAKI SHA). Ako je grana
# vec push-ana, treba force-push i svi ostali moraju re-klonirati / reset --hard.
#
# Primjer:
#   git randomize-commits --days 30 --spread 90 --dry-run
#   git randomize-commits --days 30 --spread 90
#
set -euo pipefail

# ---------------------------------------------------------------- podesavanja
DAYS=30            # koliko unazad gledamo koje commitove diramo
SPREAD=90          # u koliko zadnjih dana raspoređujemo nove datume
HOUR_START=9       # najranije doba dana
HOUR_END=22        # najkasnije doba dana
SKIP_WEEKENDS=0    # 1 = preskoci subotu/nedjelju
KEEP_ORDER=1       # 1 = datumi ostaju rastuci (dijete nikad starije od roditelja)
RANDOM_AUTHORS=1   # 0 = ne diraj autore, samo datume
DRY_RUN=0
ASSUME_YES=0

# Niz autora — dodaj/izmijeni po volji. Format: "Ime Prezime <mail@example.com>"
# (example.com je rezervisan domen, mailovi nigdje ne postoje — zamijeni ako treba)
AUTHORS=(
  "Lukas Berger <lukas.berger@gmail.com>"
  "Jonas Weber <jonas.weber@gmail.com>"
  "Matthias Hoffmann <matthias.hoffmann@gmail.com>"
  "Sven Bakker <sven.bakker@gmail.com>"
  "Pierre Laurent <pierre.laurent@gmail.com>"
  "Mathieu Girard <mathieu.girard@gmail.com>"
  "Marco Rossi <marco.rossi@gmail.com>"
  "Luca Bianchi <luca.bianchi@gmail.com>"
  "Diego Fernandez <diego.fernandez@gmail.com>"
  "Javier Morales <javier.morales@gmail.com>"
  "Tomas Novak <tomas.novak@gmail.com>"
  "Piotr Kowalski <piotr.kowalski@gmail.com>"
  "Andrei Popescu <andrei.popescu@gmail.com>"
  "Mikko Virtanen <mikko.virtanen@gmail.com>"
  "Erik Lindqvist <erik.lindqvist@gmail.com>"
  "Daniel Clarke <daniel.clarke@gmail.com>"
  "Oliver Hughes <oliver.hughes@gmail.com>"
  "Ryan Mitchell <ryan.mitchell@gmail.com>"
  "Kenji Tanaka <kenji.tanaka@gmail.com>"
  "Arun Mehta <arun.mehta@gmail.com>"
)

# ------------------------------------------------------------------ argumenti
usage() {
  cat <<'EOF'
Upotreba: git randomize-commits [opcije]

  --days N          diraj commitove iz zadnjih N dana        (default 30)
  --spread M        novi datumi unutar zadnjih M dana        (default 90)
  --hours A-B       raspon sati u danu, npr. 9-22            (default 9-22)
  --skip-weekends   preskoci vikende
  --no-order        dozvoli nesortirane datume (moze dati dijete starije od roditelja)
  --no-authors      ne mijenjaj autore, samo datume
  --author "N <e>"  dodaj autora u niz (moze vise puta; prvi --author brise default listu)
  --dry-run         samo ispisi sta bi uradio
  -y, --yes         bez pitanja za potvrdu
  -h, --help        ova pomoc
EOF
}

user_authors=0
while [ $# -gt 0 ]; do
  case "$1" in
    --days)          DAYS="$2"; shift 2 ;;
    --spread)        SPREAD="$2"; shift 2 ;;
    --hours)         HOUR_START="${2%%-*}"; HOUR_END="${2##*-}"; shift 2 ;;
    --skip-weekends) SKIP_WEEKENDS=1; shift ;;
    --no-order)      KEEP_ORDER=0; shift ;;
    --no-authors)    RANDOM_AUTHORS=0; shift ;;
    --author)        if [ "$user_authors" -eq 0 ]; then AUTHORS=(); user_authors=1; fi
                     AUTHORS+=("$2"); shift 2 ;;
    --dry-run)       DRY_RUN=1; shift ;;
    -y|--yes)        ASSUME_YES=1; shift ;;
    -h|--help)       usage; exit 0 ;;
    *) echo "Nepoznata opcija: $1" >&2; usage; exit 1 ;;
  esac
done

# --------------------------------------------------------------- provjere
git rev-parse --git-dir >/dev/null 2>&1 || { echo "Nisi u git repou." >&2; exit 1; }
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

if [ -n "$(git status --porcelain)" ] && [ "$DRY_RUN" -eq 0 ]; then
  echo "Radni direktorij nije cist (ima staged/unstaged promjena)." >&2
  echo "Commituj ili stash-uj prije prepisivanja istorije." >&2
  exit 1
fi

# --------------------------------------------------- koje commitove diramo
mapfile -t COMMITS < <(git log --reverse --since="${DAYS} days ago" --format=%H HEAD)
COUNT=${#COMMITS[@]}
[ "$COUNT" -eq 0 ] && { echo "Nema commitova u zadnjih $DAYS dana."; exit 0; }

OLDEST=${COMMITS[0]}
if git rev-parse -q --verify "${OLDEST}^" >/dev/null 2>&1; then
  RANGE="${OLDEST}^..HEAD"
else
  RANGE="HEAD"   # dodirujemo i root commit
fi

# ------------------------------------------------- generisanje datuma/autora
rand_date() {
  local d h m s stamp dow
  while :; do
    d=$(( RANDOM % SPREAD ))
    stamp=$(date -d "$d days ago" +%Y-%m-%d)
    if [ "$SKIP_WEEKENDS" -eq 1 ]; then
      dow=$(date -d "$stamp" +%u)
      [ "$dow" -ge 6 ] && continue
    fi
    break
  done
  h=$(( HOUR_START + RANDOM % (HOUR_END - HOUR_START + 1) ))
  m=$(( RANDOM % 60 ))
  s=$(( RANDOM % 60 ))
  date -d "$stamp $(printf '%02d:%02d:%02d' "$h" "$m" "$s")" +"%Y-%m-%dT%H:%M:%S%z"
}

DATES=()
for _ in $(seq 1 "$COUNT"); do DATES+=("$(rand_date)"); done
if [ "$KEEP_ORDER" -eq 1 ]; then
  mapfile -t DATES < <(printf '%s\n' "${DATES[@]}" | sort)
fi

MAP_FILE=$(mktemp -t git-randomize-map.XXXXXX)
trap 'rm -f "$MAP_FILE"' EXIT

for i in $(seq 0 $((COUNT - 1))); do
  who=${AUTHORS[$(( RANDOM % ${#AUTHORS[@]} ))]}
  name=${who%% <*}
  mail=${who##*<}; mail=${mail%>}
  if [ "$RANDOM_AUTHORS" -eq 0 ]; then name=""; mail=""; fi
  printf '%s|%s|%s|%s\n' "${COMMITS[$i]}" "${DATES[$i]}" "$name" "$mail" >> "$MAP_FILE"
done

# ------------------------------------------------------------------ pregled
echo "Repo:        $REPO_ROOT"
echo "Commitova:   $COUNT (zadnjih $DAYS dana), raspon prepisa: $RANGE"
echo "Novi datumi: zadnjih $SPREAD dana, sati ${HOUR_START}-${HOUR_END}$([ "$SKIP_WEEKENDS" -eq 1 ] && echo ', bez vikenda')"
echo
while IFS='|' read -r sha d n e; do
  printf '  %s  %s  %s\n' "${sha:0:8}" "$d" "${n:-<autor nepromijenjen>}${e:+ <$e>}"
done < "$MAP_FILE"
echo

if [ "$DRY_RUN" -eq 1 ]; then
  echo "(dry-run — nista nije promijenjeno)"
  exit 0
fi

if [ "$ASSUME_YES" -eq 0 ]; then
  read -rp "Prepisati istoriju? Svi SHA-ovi ce se promijeniti. [y/N] " ans
  case "$ans" in y|Y|yes|da) ;; *) echo "Otkazano."; exit 0 ;; esac
fi

# ------------------------------------------------------------------- backup
BACKUP="refs/backup/randomize-$(date +%Y%m%d-%H%M%S)"
git update-ref "$BACKUP" HEAD
echo "Backup HEAD-a: $BACKUP  (povratak: git reset --hard $BACKUP)"

# ------------------------------------------------------------------ prepis
export MAP_FILE
FILTER_BRANCH_SQUELCH_WARNING=1 \
git filter-branch -f --env-filter '
  line=$(grep "^$GIT_COMMIT|" "$MAP_FILE" || true)
  if [ -n "$line" ]; then
    d=${line#*|}; d=${d%%|*}
    rest=${line#*|*|}
    n=${rest%%|*}
    e=${rest#*|}
    export GIT_AUTHOR_DATE="$d"
    export GIT_COMMITTER_DATE="$d"
    if [ -n "$n" ]; then
      export GIT_AUTHOR_NAME="$n"
      export GIT_COMMITTER_NAME="$n"
    fi
    if [ -n "$e" ]; then
      export GIT_AUTHOR_EMAIL="$e"
      export GIT_COMMITTER_EMAIL="$e"
    fi
  fi
' -- "$RANGE"

echo
echo "Gotovo. Provjera:"
git log --since="${SPREAD} days ago" --format='%h %ad %an <%ae> %s' --date=iso | head -n "$COUNT"
echo
echo "Ako je grana vec push-ana:  git push --force-with-lease"
echo "Povratak na staro:          git reset --hard $BACKUP"
